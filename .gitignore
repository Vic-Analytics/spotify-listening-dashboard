# --- Secrets: NEVER commit these ---
.env
.cache
.cache-*

# --- Your personal data: keep private ---
# The SQLite database holds your real listening history
*.db
*.sqlite
*.sqlite3
# Raw Spotify export files (but keep the folder itself via .gitkeep)
data/raw/*
!data/raw/.gitkeep

