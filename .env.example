# Copy this file to ".env" and fill in your own values.
# ".env" is listed in .gitignore, so it is never uploaded to GitHub.
# ".env.example" (this file) has no real secrets, so it IS safe to commit.

# From https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must match the Redirect URI you registered in the Spotify dashboard EXACTLY.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Leave blank: `python -m collector.login` fills this in for you.
SPOTIFY_REFRESH_TOKEN=

# Your IANA time zone name. Hour-of-day charts and 'which day did I listen' use it.
# (Spotify stores times in UTC.) List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/Chicago
