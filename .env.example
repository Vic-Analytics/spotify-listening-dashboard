# Copy this file to ".env" and fill in your own values.
# ".env" is listed in .gitignore, so it is never uploaded to GitHub.
# ".env.example" (this file) has no real secrets, so it IS safe to commit.

# From https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must match the Redirect URI you registered in the Spotify dashboard EXACTLY.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Leave blank: `python -m collector.login` fills this in for you.
SPOTIFY_REFRESH_TOKEN=
